# Jev runs through the OpenCode Zen gateway, keyless. No account, no API key.
# The free tier is jev-1.13-free with the literal credential `public` plus an
# OpenCode client fingerprint; the session/request ids default to the pair in
# ~/.omp/agent/models.yml.
#
# Only set a key if you want the rate-limited jev-1.13 (needs a workspace).
# ZEN_API_KEY=
# JEV_MODEL=jev-1.13-free
# ZEN_BASE_URL=https://opencode.ai/zen/v1
# PORT=8787
